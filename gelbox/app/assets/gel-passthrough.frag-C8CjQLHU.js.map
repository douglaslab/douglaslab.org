export default "uniform sampler2D uTex0;\n#ifdef GEL_COMPOSITE\nuniform vec3 uTint;\n#endif\n\nin vec2 vTexCoord;\nout vec4 fragColor;\n\nvoid main() {\n#ifdef GEL_COMPOSITE\n  vec4 s = texture(uTex0, vTexCoord);\n  float lum = max(max(s.r, s.g), s.b);\n  fragColor = vec4(s.rgb * uTint, lum);\n#else\n  fragColor = texture(uTex0, vTexCoord);\n#endif\n}\n"